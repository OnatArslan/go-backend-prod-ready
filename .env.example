APP_NAME=go-backend-prod-ready
APP_ENV=local

HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=1m
HTTP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info
LOG_FORMAT=json

POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom
POSTGRES_DB=ecom
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://ecom:ecom@localhost:5434/ecom?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://ecom:ecom@localhost:5434/ecom?sslmode=disable
GOOSE_MIGRATION_DIR=./sql/migrations
